DATABASE_URL=postgres://postgres@localhost:5432/outreach
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
# openssl rand -base64 32. Losing this makes saved mailbox passwords unreadable.
MAILBOX_KEY=
# Production sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=you@example.com
# Seconds between campaign emails per mailbox, varied by 30% either way
SEND_GAP_SECONDS=120
# Local testing only. Never set these in production.
# DEV_LOGIN=1
# MAIL_DEV_NO_SMTP_AUTH=1
# MAIL_DEV_INSECURE=1
# AI. Without a key the app still works with your own copy, but writes nothing.
# Let your own AI agent do the writing over MCP instead of an API key.
# AI_AGENT=1
# MCP_TOKEN=<a long random value>
# MCP_EMAIL=you@example.com
ANTHROPIC_API_KEY=
# Or OpenAI, used when ANTHROPIC_API_KEY is empty. AI_MODEL is then required.
# OPENAI_API_KEY=
# AI_MODEL=
# Or anything with the same API. A local Ollama costs nothing per email:
# OPENAI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=<a model you have pulled>
# AI_INPUT_USD_PER_MTOK=0
# AI_OUTPUT_USD_PER_MTOK=0
# Optional. Change after checking the current models and prices.
# AI_MODEL=claude-opus-5-5
# AI_INPUT_USD_PER_MTOK=5
# AI_OUTPUT_USD_PER_MTOK=25
# Lead search through People Data Labs, and email checks through ZeroBounce
LEAD_API_KEY=
EMAIL_VERIFIER_KEY=
# What each costs you, so budgets stay accurate
# LEAD_CREDIT_USD=0.25
# EMAIL_CHECK_USD=0.008
# Leads per search
# LEAD_SEARCH_SIZE=25
# Shown on the privacy and terms pages
LEGAL_NAME=
LEGAL_EMAIL=
